{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesisos.dev/schemas/citation.schema.json",
  "title": "ThesisOS Citation",
  "description": "An exact, snapshot-bound locator supporting one evidence statement.",
  "type": "object",
  "required": [
    "schema_version",
    "citation_id",
    "source_document_id",
    "snapshot_sha256",
    "quotation_mode",
    "locator",
    "quoted_text"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "citation_id": {
      "$ref": "#/$defs/stableId"
    },
    "source_document_id": {
      "$ref": "#/$defs/stableId"
    },
    "snapshot_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "quotation_mode": {
      "type": "string",
      "enum": [
        "exact_quote",
        "table_value",
        "faithful_paraphrase"
      ]
    },
    "locator": {
      "oneOf": [
        {
          "$ref": "#/$defs/pageLocator"
        },
        {
          "$ref": "#/$defs/paragraphLocator"
        },
        {
          "$ref": "#/$defs/tableLocator"
        },
        {
          "$ref": "#/$defs/sectionLocator"
        },
        {
          "$ref": "#/$defs/lineRangeLocator"
        }
      ]
    },
    "quoted_text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 10000
    }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "quotation_mode": {
            "const": "table_value"
          }
        },
        "required": [
          "quotation_mode"
        ]
      },
      "then": {
        "properties": {
          "locator": {
            "$ref": "#/$defs/tableLocator"
          }
        }
      }
    }
  ],
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$"
    },
    "pageLocator": {
      "type": "object",
      "required": [
        "kind",
        "page"
      ],
      "properties": {
        "kind": {
          "const": "page"
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "page_label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "paragraphLocator": {
      "type": "object",
      "required": [
        "kind",
        "paragraph_start",
        "paragraph_end"
      ],
      "properties": {
        "kind": {
          "const": "paragraph"
        },
        "paragraph_start": {
          "type": "integer",
          "minimum": 1
        },
        "paragraph_end": {
          "type": "integer",
          "minimum": 1
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "tableLocator": {
      "type": "object",
      "required": [
        "kind",
        "table"
      ],
      "properties": {
        "kind": {
          "const": "table"
        },
        "table": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "page": {
          "type": "integer",
          "minimum": 1
        },
        "row": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "column": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "sectionLocator": {
      "type": "object",
      "required": [
        "kind",
        "section"
      ],
      "properties": {
        "kind": {
          "const": "section"
        },
        "section": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "subsection": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        }
      },
      "additionalProperties": false
    },
    "lineRangeLocator": {
      "type": "object",
      "required": [
        "kind",
        "line_start",
        "line_end"
      ],
      "properties": {
        "kind": {
          "const": "line_range"
        },
        "line_start": {
          "type": "integer",
          "minimum": 1
        },
        "line_end": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    }
  }
}
