{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://thesisos.dev/schemas/thesis-card.schema.json",
  "title": "ThesisOS Thesis Card",
  "description": "A versioned, falsifiable, user-owned investment thesis for one company.",
  "type": "object",
  "required": [
    "schema_version",
    "thesis_id",
    "company",
    "one_sentence_thesis",
    "assumptions",
    "key_indicators",
    "falsification_conditions",
    "strongest_counter_case",
    "valuation_anchor",
    "unknown_questions",
    "version"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "thesis_id": {
      "$ref": "#/$defs/stableId"
    },
    "company": {
      "$ref": "#/$defs/company"
    },
    "one_sentence_thesis": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    },
    "assumptions": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "key_indicators": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/keyIndicator"
      }
    },
    "falsification_conditions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/falsificationCondition"
      }
    },
    "strongest_counter_case": {
      "$ref": "#/$defs/counterCase"
    },
    "valuation_anchor": {
      "$ref": "#/$defs/valuationAnchor"
    },
    "unknown_questions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/unknownQuestion"
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100
      }
    },
    "version": {
      "$ref": "#/$defs/versionMetadata"
    }
  },
  "additionalProperties": false,
  "$defs": {
    "stableId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^(?!(?:[Cc][Oo][Nn]|[Pp][Rr][Nn]|[Aa][Uu][Xx]|[Nn][Uu][Ll]|[Cc][Oo][Mm][1-9]|[Ll][Pp][Tt][1-9])(?:\\.|$))[A-Za-z0-9](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?$"
    },
    "company": {
      "type": "object",
      "required": [
        "company_id",
        "name",
        "ticker",
        "market",
        "research_status"
      ],
      "properties": {
        "company_id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "ticker": {
          "type": "string",
          "minLength": 1,
          "maxLength": 50
        },
        "market": {
          "type": "string",
          "description": "Prefer an ISO 10383 MIC where available.",
          "minLength": 1,
          "maxLength": 50
        },
        "research_status": {
          "type": "string",
          "enum": [
            "holding",
            "watchlist",
            "research"
          ]
        }
      },
      "additionalProperties": false
    },
    "assumption": {
      "type": "object",
      "required": [
        "assumption_id",
        "statement",
        "indicator_ids",
        "falsification_condition_ids"
      ],
      "properties": {
        "assumption_id": {
          "$ref": "#/$defs/stableId"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "indicator_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "falsification_condition_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    },
    "keyIndicator": {
      "type": "object",
      "required": [
        "indicator_id",
        "name",
        "why_it_matters",
        "linked_assumption_ids"
      ],
      "properties": {
        "indicator_id": {
          "$ref": "#/$defs/stableId"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "why_it_matters": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "unit_or_definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 300
        },
        "linked_assumption_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    },
    "falsificationCondition": {
      "type": "object",
      "required": [
        "condition_id",
        "statement",
        "linked_assumption_ids"
      ],
      "properties": {
        "condition_id": {
          "$ref": "#/$defs/stableId"
        },
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "linked_assumption_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    },
    "counterCase": {
      "type": "object",
      "required": [
        "statement",
        "attacked_assumption_ids",
        "basis"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1,
          "maxLength": 5000
        },
        "attacked_assumption_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        },
        "basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 3000
        },
        "evidence_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    },
    "valuationAnchor": {
      "type": "object",
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "provided",
            "partial",
            "insufficient_evidence"
          ]
        },
        "valuation_basis": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "reasonable_range": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "market_implied_assumptions": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1000
          }
        },
        "sensitive_variables": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 300
          }
        },
        "insufficiency_reason": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        }
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "provided"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "valuation_basis",
              "reasonable_range",
              "market_implied_assumptions",
              "sensitive_variables"
            ],
            "not": {
              "required": [
                "insufficiency_reason"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "partial"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "insufficiency_reason"
            ],
            "anyOf": [
              {
                "required": [
                  "valuation_basis"
                ]
              },
              {
                "required": [
                  "reasonable_range"
                ]
              },
              {
                "required": [
                  "market_implied_assumptions"
                ]
              },
              {
                "required": [
                  "sensitive_variables"
                ]
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "status": {
                "const": "insufficient_evidence"
              }
            },
            "required": [
              "status"
            ]
          },
          "then": {
            "required": [
              "insufficiency_reason"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "valuation_basis"
                  ]
                },
                {
                  "required": [
                    "reasonable_range"
                  ]
                },
                {
                  "required": [
                    "market_implied_assumptions"
                  ]
                },
                {
                  "required": [
                    "sensitive_variables"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "unknownQuestion": {
      "type": "object",
      "required": [
        "question_id",
        "question",
        "linked_assumption_ids"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/stableId"
        },
        "question": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "linked_assumption_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/stableId"
          }
        }
      },
      "additionalProperties": false
    },
    "versionMetadata": {
      "type": "object",
      "required": [
        "as_of_date",
        "version_id",
        "created_at",
        "updated_at",
        "supersedes",
        "user_confirmed"
      ],
      "properties": {
        "as_of_date": {
          "type": "string",
          "format": "date"
        },
        "version_id": {
          "$ref": "#/$defs/stableId"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "updated_at": {
          "type": "string",
          "format": "date-time"
        },
        "supersedes": {
          "oneOf": [
            {
              "$ref": "#/$defs/stableId"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_confirmed": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    }
  }
}
